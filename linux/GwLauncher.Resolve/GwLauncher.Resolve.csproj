<Project Sdk="Microsoft.NET.Sdk">

    <!-- Separate module: turns a Windows-compacted (WOF) file into a plain file. Depends on nothing else in the launcher. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>GwLauncher.Resolve</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- The validated decoders, shared with the wofdecode tool. -->
    <ItemGroup>
        <Compile Include="..\GwLauncher.Wof\WofBitstream.cs" Link="Decoders\WofBitstream.cs" />
        <Compile Include="..\GwLauncher.Wof\LzxWimDecoder.cs" Link="Decoders\LzxWimDecoder.cs" />
        <Compile Include="..\GwLauncher.Wof\XpressDecoder.cs" Link="Decoders\XpressDecoder.cs" />
    </ItemGroup>

</Project>
