<Project Sdk="Microsoft.NET.Sdk">

    <!-- Built as a self-contained 32-bit Windows exe so it runs under Wine with no .NET install, and matches the 32-bit game. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>GwLauncher.Injector</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>GwLauncher.Injector</AssemblyName>
        <RuntimeIdentifier>win-x86</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <!-- Single-file bundles fail to start under Wine, so the publish stays a folder that the launcher unpacks. -->
        <PublishSingleFile>false</PublishSingleFile>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

</Project>
