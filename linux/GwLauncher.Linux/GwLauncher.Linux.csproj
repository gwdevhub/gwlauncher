<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>GwLauncher.Linux</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>gwlauncher</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\GwLauncher.Core\GwLauncher.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Newtonsoft.Json" />
        <Using Include="System.Diagnostics" />
    </ItemGroup>

    <!-- The Windows DLL loader, copied next to the CLI so mods can be loaded into the game. -->
    <ItemGroup>
        <Content Include="..\GwLauncher.Injector\bin\Release\net10.0\win-x86\publish\**" Link="injector\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\GwLauncher.Injector\bin\Release\net10.0\win-x86\publish')" />
    </ItemGroup>

</Project>
