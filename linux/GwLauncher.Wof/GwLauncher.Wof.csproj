<Project Sdk="Microsoft.NET.Sdk">

    <!-- Decodes Windows Overlay Filter (WOF) LZX/raw streams, e.g. the :WofCompressedData stream of a compacted Gw.dat. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>GwLauncher.Wof</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>wofdecode</AssemblyName>
    </PropertyGroup>

</Project>
