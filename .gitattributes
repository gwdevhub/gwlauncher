# Store text as LF in the repository; each checkout gets its platform's line endings.
* text=auto

# Shell scripts and Dockerfiles run on Linux, so they keep LF even on a Windows checkout.
*.sh text eol=lf
Dockerfile* text eol=lf

# Binary assets are never converted.
*.ico binary
*.png binary
*.jpg binary
*.webp binary
*.woff binary
*.woff2 binary
*.dll binary
*.exe binary
*.pdb binary
*.zip binary
*.tpf binary
