# The compilers for Linux and mingw, in one image so builds reuse them instead of reinstalling.
# build.sh and build.ps1 tag it by a hash of this file, so it is rebuilt only when this file changes.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends cmake ninja-build pkg-config g++ mingw-w64 \
 && rm -rf /var/lib/apt/lists/*
