<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>GwLauncher.Ui</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <ProjectReference Include="..\GwLauncher.Shared\GwLauncher.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="..\..\GW Launcher\Resources\gwlauncher-helmet.png" Link="Assets\gwlauncher-helmet.png" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="GW_Launcher.Classes" />
        <Using Include="GW_Launcher.Launcher" />
        <Using Include="GW_Launcher.Utilities" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GwLauncher.Linux" />
    </ItemGroup>

</Project>
