<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>GwLauncher.Ui</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\GwLauncher.Shared\GwLauncher.Shared.csproj" />
    </ItemGroup>

    <!-- The page and the helmet icon ship inside the assembly, so each platform's window loads the same files. -->
    <ItemGroup>
        <EmbeddedResource Include="wwwroot\**" LogicalName="wwwroot/%(Filename)%(Extension)" />
        <EmbeddedResource Include="..\..\GW Launcher\Resources\gwlauncher-helmet.png" LogicalName="gwlauncher-helmet.png" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="GW_Launcher.Classes" />
        <Using Include="GW_Launcher.Launcher" />
        <Using Include="GW_Launcher.Utilities" />
    </ItemGroup>

</Project>
