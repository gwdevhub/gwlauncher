# Build directories
Debug/
Release/
Publish/
packages/
.vs/
*exe
*.dll
*.rar

# user files
*.user

# Rider project files
.idea/

# Bloated Windows Databases
*.sdf
*.opensdf
*.suo

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch
*.idb
*.pdb
*.ipdb
*.iobj
*.opendb
*.json
*.vcxproj.user
*.VC.db
.aider*


# The web page project keeps its JSON config.
!frontend/*.json

# The native layer's build presets.
!backend/CMakePresets.json

# Native layer build folders.
backend/build*/
backend/cmake-build-*/

# Native launcher packages.
bin/

# The vendored WebView2 loader is committed, unlike the other build output in bin/.
!backend/third_party/webview2/bin/
!backend/third_party/webview2/bin/**/*.dll

# Node packages, in every folder.
node_modules/

# The launcher writes its stylesheet override beside itself.
GWLauncher.override.css
