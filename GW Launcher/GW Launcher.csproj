<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>GW_Launcher</RootNamespace>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <!-- The release is one exe, so WebView2's native loader is bundled into it rather than left beside it. -->
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <ImplicitUsings>enable</ImplicitUsings>
        <StartupObject>GW_Launcher.Program</StartupObject>
        <ApplicationIcon>Resources\gwlauncher-helmet.ico</ApplicationIcon>
        <BaseOutputPath>..\</BaseOutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <Platforms>x86;AnyCPU</Platforms>
        <PlatformTarget>x86</PlatformTarget>
        <DebugType>portable</DebugType>
        <Copyright>2015 GregLando113</Copyright>
        <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
        <WarningLevel>7</WarningLevel>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x86'">
        <WarningLevel>7</WarningLevel>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <WarningLevel>7</WarningLevel>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <WarningLevel>7</WarningLevel>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\shared\GwLauncher.Ui\GwLauncher.Ui.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="PeNet" Version="6.1.2" />
        <PackageReference Include="SystemExtensions.NetCore" Version="1.9.0" />
        <PackageReference Include="SystemExtensions.NetStandard" Version="1.9.0" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Properties\PublishProfiles\" />
    </ItemGroup>

    <ItemGroup>
        <None Include=".editorconfig" />
    </ItemGroup>

    <!-- The WebView2 package references its WPF control on every .NET target. This app only uses the WinForms one. -->
    <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
        </ItemGroup>
    </Target>

</Project>
